#.env

DEV = true

# Parameters for PID-controller
K_P = 0.1
K_D = 0.1
K_I = 0.1

# Parameters for NN-controller
LAYERS_AND_NODES = "5,5" # example: '5,5' is 2 hidden layers with 5 nodes each
ACTIVATION_FUNCTIONS = "relu,relu" # 'sigmoid', 'tanh', 'Relu' | example: 'relu,relu' for 2 hidden layers with relu activations
WEIGHT_UPPER_BOUNDRY = 1.0
WEIGHT_LOWER_BOUNDRY = -1.0
BIAS_UPPER_BOUNDRY = 0.5
BIAS_LOWER_BOUNDRY = -0.5

#Parameter for controller choice and plant choice
CONTROLLER_TYPE = "pid" # 'pid', 'nn'
PLANT_TYPE = "bathtub" # 'bathtub', 'cournot', 'population'

# Parameters for CONSYS
EPOCHS = 100
TIMESTEPS = 20
LEARNING_RATE = 0.01
DISTURBANCE_UPPER_BOUNDRY = 0.01
DISTURBANCE_LOWER_BOUNDRY = -0.01

#Parameters for Bathtub plant
CSA_A = 100.0
CSA_C = 2.0
INITIAL_HEIGHT = 50.0
TARGET_HEIGHT = 50.0

#Parameters for Cournot plant
MAX_PRICE = 4.0
PRODUCTION_COST = 0.1
INITIAL_PRODUCTION = 0.5
TARGET_PROFIT = 2.0

#Parameters for Population plant
FERTILITY_RATE = 0.05
MORTALITY_RATE = 0.02
CARRYING_CAPACITY = 150.0
INITIAL_POPULATION = 100.0
TARGET_POPULATION = 100.0